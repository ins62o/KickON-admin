# 빈 예제: 실제 Secret 또는 프로젝트 주소를 커밋하지 않는다
# 신규 환경에서만 .env.development.local로 복사하며 기존 파일을 덮어쓰지 않는다
# NEXT_PUBLIC_* 호환 이름은 공개 URL/publishable 키 전용이다
KICKON_ENVIRONMENT=development
# 선택 환경이 실제 구성된 경우에만 development 또는 production으로 지정
KICKON_LOGIN_ENVIRONMENT=

# 브라우저에 전달되는 공개 연결: 필요한 환경만 설정
NEXT_PUBLIC_KICKON_DEVELOPMENT_SUPABASE_URL=
NEXT_PUBLIC_KICKON_DEVELOPMENT_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_KICKON_PRODUCTION_SUPABASE_URL=
NEXT_PUBLIC_KICKON_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_API_BASE_URL=
NEXT_PUBLIC_SPORTSMONKS_API_ALLOWANCE=

# 서버 전용: 사용하는 기능만 설정, 브라우저용 접두사 금지
SUPABASE_METRICS_SECRET_KEY=
FOOTBALL_SYNC_SECRET=
SPORTMONKS_API_TOKEN=
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
# 기존 collector가 구성된 경우에만 cloud 지정
SUPABASE_MONITORING_SOURCE=
