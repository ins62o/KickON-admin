# Development build and local admin API
KICKON_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_DEVELOPMENT_PUBLISHABLE_KEY

# The console can switch targets without a reload, so both public target configs are required.
NEXT_PUBLIC_KICKON_DEVELOPMENT_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co
NEXT_PUBLIC_KICKON_DEVELOPMENT_SUPABASE_PUBLISHABLE_KEY=YOUR_DEVELOPMENT_PUBLISHABLE_KEY
NEXT_PUBLIC_KICKON_PRODUCTION_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_KICKON_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY
NEXT_PUBLIC_KICKON_DEVELOPMENT_ADMIN_API_BASE_URL=http://127.0.0.1:3002/api
NEXT_PUBLIC_KICKON_PRODUCTION_ADMIN_API_BASE_URL=https://YOUR_PRODUCTION_ADMIN_API_HOST/api

# Public UI settings. NEXT_PUBLIC_KICKON_ENVIRONMENT and its default are derived above.
NEXT_PUBLIC_ADMIN_SYNC_ENABLED=true
KICKON_SUPPORT_EMAIL=kickon.offical@gmail.com

# Local admin API only. Never expose these values through NEXT_PUBLIC_* variables.
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ADMIN_API_PORT=3002
SUPABASE_METRICS_SECRET_KEY=
SUPABASE_DATABASE_LIMIT_GB=
SUPABASE_STORAGE_LIMIT_GB=
SPORTSMONKS_API_ALLOWANCE=
FOOTBALL_SYNC_SECRET=
KICKON_PROVIDER_SNAPSHOT_SECRET=
KICKON_ERROR_INGEST_SECRET=
ERROR_HASH_SALT=
KICKON_ADMIN_AUTH_REQUIRED=false
