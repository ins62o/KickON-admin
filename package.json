{
  "name": "kickon-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server/admin-api/dev.mjs",
    "dev:web": "next dev",
    "dev:admin-api": "npm run build:admin-api:local && node dist/admin-api/local-server.js",
    "build": "next build --webpack",
    "build:static": "next build --webpack",
    "build:admin-api": "esbuild server/admin-api/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/admin-api/index.js",
    "build:admin-api:local": "esbuild server/admin-api/local-server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/admin-api/local-server.js",
    "start": "python3 -m http.server 3000 --directory out",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
