# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/.data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.development.example
!/.env.production.example

# vercel
.vercel

# supabase cli
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# private credentials and runtime databases (not disposable caches)
*.key
*.p12
*.pfx
*.sqlite
*.sqlite-wal
*.sqlite-shm

# generated Python files
__pycache__/
*.py[cod]

# browser authentication state and network captures
*.har
**/playwright/.auth/
storage-state*.json
*.storage-state.json

# operational evidence: preserve in place and existing external archives
/docs/qa/
/docs/operations/push-reliability-20261025/
/docs/operations/dispatcher-release-20261025/
/docs/operations/dispatcher-release-20261025-capture-result.md
/docs/operations/dispatcher-release-20261025-current-artifact.md
