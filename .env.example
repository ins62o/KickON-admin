# 브라우저에 노출 가능한 Supabase publishable 값만 NEXT_PUBLIC_*에 둡니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# 서버에서만 사용합니다. 클라이언트 번들에 절대 노출하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# 프로젝트 Metrics와 Storage API를 서버에서 읽는 sb_secret_ 형식의 Secret API key입니다.
# service role JWT와 구분하며 브라우저·모바일 번들에 절대 포함하지 않습니다.
SUPABASE_METRICS_SECRET_KEY=
# Supabase Management API를 추가 연동할 때만 사용하는 서버 전용 토큰입니다.
# 현재 UI는 아래 Secret API key와 DB RPC를 우선 사용합니다.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
SUPABASE_PROJECT_REF=
# 대시보드 사용률 계산에 사용하는 현재 플랜의 DB·Storage 한도(10진 GB)입니다.
SUPABASE_DATABASE_LIMIT_GB=
SUPABASE_STORAGE_LIMIT_GB=
KICKON_ENVIRONMENT=development
# 헤더의 서버 전환 메뉴에서 사용할 관리자 콘솔 주소입니다.
KICKON_DEVELOPMENT_ADMIN_URL=http://localhost:3000
KICKON_PRODUCTION_ADMIN_URL=https://YOUR_ADMIN_DOMAIN

# 전체/실시간 동기화 Edge Function을 서버에서 호출할 때만 사용합니다.
FOOTBALL_SYNC_SECRET=

# 동기화 백엔드가 정제된 SportsMonks 원본 Snapshot을 적재할 때 사용합니다.
# FOOTBALL_SYNC_SECRET과 분리하고 싶을 때 설정합니다. 모바일 번들에는 넣지 않습니다.
KICKON_PROVIDER_SNAPSHOT_SECRET=
# SportsMonks 현재 호출 주기의 전체 허용량입니다.
SPORTSMONKS_API_ALLOWANCE=
# SportsMonks 원본 API 토큰입니다. 브라우저·모바일 번들에 포함하지 않습니다.
SPORTSMONKS_API_TOKEN=

# 백엔드 오류 수집 전용입니다. 모바일 앱 번들에는 넣지 않습니다.
KICKON_ERROR_INGEST_SECRET=

# 인증 사용자 ID를 되돌릴 수 없는 Hash로 바꿀 때 사용합니다.
ERROR_HASH_SALT=

# 개발 환경에서만 선택적으로 false를 사용할 수 있습니다. production은 항상 인증을 강제합니다.
KICKON_ADMIN_AUTH_REQUIRED=true
# 쓰기 Server Action을 허용할 관리자 콘솔 Origin 목록입니다(쉼표 구분).
# 비어 있으면 Next.js의 기본 Server Action Origin 검사를 사용합니다.
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
